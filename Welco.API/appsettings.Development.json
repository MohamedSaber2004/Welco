{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Ocelot": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7166",
      "http://localhost:5293",
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:5173",
      "http://localhost:56304"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 300,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "JwtSettings": {
    "Issuer": "https://localhost:7203/",
    "Audience": "https://localhost:7203/",
    "ValidIssuers": [
      "https://localhost:7203/",
      "http://localhost:5066/",
      "https://localhost:7166/",
      "http://localhost:5293/",
      "http://welco-authservice.runasp.net/",
      "https://welco-authservice.runasp.net/",
      "http://welco-gateway.runasp.net/",
      "https://welco-gateway.runasp.net/"
    ],
    "ValidAudiences": [
      "https://localhost:7203/",
      "http://localhost:5066/",
      "https://localhost:7166/",
      "http://localhost:5293/",
      "http://welco-authservice.runasp.net/",
      "https://welco-authservice.runasp.net/",
      "http://welco-gateway.runasp.net/",
      "https://welco-gateway.runasp.net/"
    ],
    "ExpiryInMinutes": 60,
    "RefreshTokenExpiryDays": 30,
    "Secret": "V5B?*77+gzD_pk+2!%ORg<i)<D$DH+Xf.nECc?];2l;"
  }
}

