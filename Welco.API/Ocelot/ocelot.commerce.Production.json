{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/v1/carts/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [{ "Host": "welco-commerce.runasp.net", "Port": 443 }],
      "UpstreamPathTemplate": "/api/v1/carts/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": { "AuthenticationProviderKey": "Bearer", "AllowedScopes": [] },
      "DangerousAcceptAnyServerCertificateValidator": false
    },
    {
      "DownstreamPathTemplate": "/api/v1/orders/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [{ "Host": "welco-commerce.runasp.net", "Port": 443 }],
      "UpstreamPathTemplate": "/api/v1/orders/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": { "AuthenticationProviderKey": "Bearer", "AllowedScopes": [] },
      "DangerousAcceptAnyServerCertificateValidator": false
    },
    {
      "DownstreamPathTemplate": "/openapi/v1.json",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [{ "Host": "welco-commerce.runasp.net", "Port": 443 }],
      "UpstreamPathTemplate": "/api/docs/commerce/openapi.json",
      "UpstreamHttpMethod": [ "GET" ],
      "DangerousAcceptAnyServerCertificateValidator": false
    },
    {
      "DownstreamPathTemplate": "/scalar/v1",
      "DownstreamScheme": "https",
