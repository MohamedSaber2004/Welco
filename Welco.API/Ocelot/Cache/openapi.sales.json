      "CreateQuoteCommand": {
        "type": "object",
        "properties": {
          "rfqId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateQuoteItemDto"
            }
          }
        }
      },
      "CreateQuoteItemDto": {
        "type": "object",
        "properties": {
