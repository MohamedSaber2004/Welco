@Provider.Services.API_HostAddress = https://localhost:7205
@AccessToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..tBIeLitOZup0IN9l0w3UnajYZV-tyiePBybvPatjDrQ


### Get all providers (paginated)
GET {{Provider.Services.API_HostAddress}}/api/v1/providers?pageNumber=1&pageSize=10
Accept: application/json
Accept-Language: ar
Authorization: Bearer {{AccessToken}}

### Get provider by id
GET {{Provider.Services.API_HostAddress}}/api/v1/providers/{id}
Accept: application/json

### Create provider (also creates the provider login user)
POST {{Provider.Services.API_HostAddress}}/api/v1/providers
Content-Type: application/json

{
  "commercialName": "Modern Dental Supplies",
  "companyName": "Modern Dental Supplies Co.",
  "commercialRegistrationNumber": "CR-123456",
  "contactPersonName": "Ahmed Ali",
  "contactPersonPhone": "+966500000000",
  "phone": "+966500000001",
  "email": "provider@example.com",
  "password": "Provider@123",
  "address": "Riyadh, Saudi Arabia",
  "notes": "Dental equipment distributor.",
  "imageName": "provider-logo.png"
}

### Update provider
PUT {{Provider.Services.API_HostAddress}}/api/v1/providers/{id}
Content-Type: application/json

{
  "commercialName": "Modern Dental Supplies",
  "companyName": "Modern Dental Supplies Co.",
  "phone": "+966500000002",
  "notes": "Updated notes.",
  "isActive": true
}

### Delete provider (soft delete)
DELETE {{Provider.Services.API_HostAddress}}/api/v1/providers/{id}
Accept: application/json
